diff --git a/src/arch/riscv/isa/decoder.isa b/src/arch/riscv/isa/decoder.isa
--- a/src/arch/riscv/isa/decoder.isa
+++ b/src/arch/riscv/isa/decoder.isa
@@ -537,2 +537,22 @@
     0x3: decode OPCODE5 {
+        // Teaching-only NPU instructions in the custom-0 major opcode.
+        // custom-0 is 0x0b in the raw instruction, while OPCODE5 is bits 6:2.
+        0x02: decode FUNCT3 {
+            format ROp {
+                0x0: decode FUNCT7 {
+                    0x0: decode RS2 {
+                        0x00: npu_echo({{
+                            Rd = Rs1;
+                        }});
+                    }
+                    0x1: npu_add({{
+                        // The host-side SystemC adapter blocks until the
+                        // modeled engine returns its result.
+                        extern uint64_t npu_systemc_add(uint64_t, uint64_t);
+                        Rd = rvSext(npu_systemc_add(Rs1, Rs2));
+                    }});
+                }
+            }
+        }
+
         0x00: decode FUNCT3 {
